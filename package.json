{
  "name": "vscicons",
  "displayName": "Icons – Maintained",
  "version": "1.2.8",
  "description": "Beautiful file and folder icons for Visual Studio Code",
  "categories": [
    "Other",
    "Themes"
  ],
  "keywords": [
    "file-icons",
    "folder-icons",
    "icon-theme",
    "icons",
    "material-icons",
    "theme",
    "vscode-icons"
  ],
  "homepage": "https://github.com/yusifaliyevpro/vscode-icons#readme",
  "bugs": {
    "url": "https://github.com/yusifaliyevpro/vscode-icons/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Yusif Aliyev",
    "email": "yusifaliyevpro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yusifaliyevpro/vscode-icons"
  },
  "funding": [
    {
      "type": "Kofe.al",
      "url": "https://kofe.al/@yusifaliyevpro"
    }
  ],
  "sponsor": {
    "url": "https://kofe.al/@yusifaliyevpro"
  },
  "publisher": "yusifaliyevpro",
  "type": "module",
  "scripts": {
    "build": "tsdown && node ./out/extension.js",
    "vsix": "pnpm build && vsce package",
    "check": "greenly",
    "release": "git pull && pnpm version patch --no-git-tag-version && node --no-warnings scripts/release.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "generate": "node --no-warnings folder-icon-maker/generate.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/vscode": "1.60.0",
    "@vscode/vsce": "3.9.2",
    "greenly": "1.1.5",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "icons",
        "label": "Icons",
        "path": "./icons.json"
      }
    ]
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#45403d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.60.0"
  }
}
